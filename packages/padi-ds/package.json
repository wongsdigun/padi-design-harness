{
  "name": "@frontend-shared/padi-ds",
  "version": "1.0.3",
  "private": false,
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://gitlab.playcourt.id/api/v4/projects/32795/packages/npm/"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./logos/*": "./dist/assets/logos/*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:lib",
    "build:next": "next build",
    "build:lib": "node scripts/clean-dist.mjs && npm run build:esm && npm run build:cjs && node scripts/copy-css.mjs",
    "build:esm": "tsc -p tsconfig.lib.json --module esnext --outDir dist/esm",
    "build:cjs": "tsc -p tsconfig.lib.json --module commonjs --moduleResolution node --outDir dist/cjs",
    "start": "next start",
    "lint": "eslint",
    "prepublishOnly": "npm run build:lib",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=chpt_057c6a9006b7994"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
